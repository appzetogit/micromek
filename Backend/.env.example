# Copy to Backend/.env and fill in. Only MONGODB_URI and JWT_SECRET are required
# to boot — everything else has a default or degrades gracefully.

NODE_ENV=development
# The frontend defaults its API base to http://localhost:5000/api/v1, so keep
# this at 5000 unless you also set VITE_API_BASE_URL for the frontend.
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=zicab_taxi

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5180,http://localhost:5190
FRONTEND_URL=http://localhost:5190
APP_NAME=ZI CAB

# Optional. When disabled the server falls back to in-memory rate limiting.
REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379

# Optional integrations — features that use them stay off until configured.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASS=

# --- SMSIndiaHub OTP ---
# SMS_INDIA_HUB_API_KEY=
# SMS_INDIA_HUB_SENDER_ID=
# SMS_INDIA_HUB_DLT_TEMPLATE_ID=
# OTP_EXPIRY_MINUTES=10
# Set true to skip the provider and use a static OTP in development.
# USE_DEFAULT_OTP=false

# ---------------------------------------------------------------------------
# Platform modules (franchise, EV, commerce, leads). All optional: a module
# whose keys are missing stays off and says so (503 / log line).
# Full lists: src/modules/{ev,commerce,leads}/README.md
# ---------------------------------------------------------------------------
# EV telematics: mock (dev default) | generic_rest | none. Production defaults to off.
EV_PROVIDER=
EV_API_BASE_URL=
EV_API_KEY=
EV_POLL_SECONDS=60
EV_WEBHOOK_SECRET=

# WhatsApp Cloud API + Meta Lead Ads
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_BUSINESS_ACCOUNT_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
WA_TPL_ORDER_CONFIRMED=
WA_TPL_ORDER_SHIPPED=
WA_TPL_ORDER_DELIVERED=
WA_TPL_CART_REMINDER=
WA_TPL_PAYMENT_REMINDER=
LEADS_AUTO_ASSIGN=round_robin

# Commerce shipping (Razorpay keys come from Admin > Payment Gateways)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
BIGSHIP_BASE_URL=
BIGSHIP_USERNAME=
BIGSHIP_PASSWORD=
BIGSHIP_ACCESS_KEY=
SHIPPING_WEBHOOK_SECRET=
